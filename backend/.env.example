NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=100
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# AI provider: set AI_API_KEY for Groq (free, https://console.groq.com/keys) or any OpenAI-compatible API,
# otherwise GEMINI_API_URL is used.
AI_API_KEY=your-groq-api-key
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=openai/gpt-oss-20b   (list: https://console.groq.com/docs/models)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent?key=<api-key>